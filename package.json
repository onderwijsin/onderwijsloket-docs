{
  "name": "onderwijsloket-docs",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build --profile=verbose",
    "build:coolify": "nuxt cleanup && NODE_OPTIONS=\"--max-old-space-size=8192\" pnpm build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "release": "semantic-release",
    "analyze": "nuxt analyze",
    "env:check": "varlock load",
    "env:typegen": "varlock codegen",
    "nuxt:prepare": "nuxt prepare",
    "prepare": "husky || true && pnpm nuxt:prepare",
    "typecheck": "pnpm env:typegen && nuxi typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@ai-sdk/gateway": "catalog:",
    "@ai-sdk/mcp": "catalog:",
    "@ai-sdk/mistral": "catalog:",
    "@ai-sdk/vue": "catalog:",
    "@comark/nuxt": "catalog:",
    "@nuxtjs/plausible": "catalog:",
    "@nuxtjs/turnstile": "catalog:",
    "@scalar/nuxt": "catalog:",
    "@scalar/openapi-parser": "catalog:",
    "@varlock/proton-pass-plugin": "catalog:",
    "@varlock/vite-integration": "catalog:",
    "ai": "catalog:",
    "better-sqlite3": "catalog:",
    "docus": "catalog:",
    "nuxt": "catalog:",
    "nuxt-schema-org": "catalog:",
    "ofetch": "catalog:",
    "ufo": "catalog:",
    "unstorage": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@inspira-ui/plugins": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/git": "catalog:",
    "@semantic-release/github": "catalog:",
    "@semantic-release/npm": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@types/cloudflare-turnstile": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "consola": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "prettier-plugin-mdc": "catalog:",
    "semantic-release": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "vue-tsc": "catalog:"
  },
  "packageManager": "pnpm@11.11.0",
  "varlock": {
    "loadPath": "./envs/"
  }
}
